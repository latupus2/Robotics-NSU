<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- DiffDrive плагин (адаптирован для 4 колёс: группы joints для left/right) -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Без префикса my_robot:: в Harmonic! -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_offset_y * 2}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>

      <!-- ВАЖНО: в Harmonic TF odom→base_link публикуется только если включено -->
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>  <!-- Explicit топик /joint_states -->
    </plugin>
  </gazebo>

  <!-- Физика для base_link -->
  <gazebo reference="base_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- Физика для колёс (для всех 4; используйте макрос или повторите) -->
  <gazebo reference="front_left_wheel">
    <mu1>100.0</mu1>  <!-- Высокое в боковом направлении -->
    <mu2>0.0</mu2>    <!-- Нулевое в направлении качения -->
    <fdir1>0 1 0</fdir1>  <!-- Направление для mu1: боковое (y) -->
    <kp>100000.0</kp>  <!-- Снижено -->
    <kd>10.0</kd>      <!-- Снижено -->
    <minDepth>0.002</minDepth>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>100.0</mu1>
    <mu2>0.0</mu2>
    <fdir1>0 1 0</fdir1>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <mu1>100.0</mu1>
    <mu2>0.0</mu2>
    <fdir1>0 1 0</fdir1>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>100.0</mu1>
    <mu2>0.0</mu2>
    <fdir1>0 1 0</fdir1>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
  </gazebo>

  <!-- Для кастеров: низкое трение для скольжения -->
  <gazebo reference="caster_front">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="caster_back">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <!-- Для новых частей: upper_body и headlights (низкое трение, если контактируют) -->
  <gazebo reference="upper_body">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="left_headlight">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>50000.0</kp>
    <kd>5.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="right_headlight">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>50000.0</kp>
    <kd>5.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <!-- Лидар -->
  <gazebo reference="lidar_link">
     <sensor name="lidar_sensor" type="gpu_lidar">  <!-- Изменено с gpu_ray на gpu_lidar -->
      <topic>/model/my_robot/lidar/scan</topic>
      <pose>0 0 0 1.5708 0 0</pose>
      <visualize>true</visualize>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
      <frame_name>lidar_link</frame_name>
      <gz_frame_id>lidar_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

</robot>