<?xml version="1.0"?>
<robot name="my_unique_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ====================== КОНСТАНТЫ ====================== -->
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width"  value="0.08"/>
  <xacro:property name="base_size_x" value="1.2"/>
  <xacro:property name="base_size_y" value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="upper_size_x" value="0.4"/>
  <xacro:property name="upper_size_y" value="0.35"/>
  <xacro:property name="upper_height" value="0.15"/>
  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="wheel_offset_y" value="0.3"/>
  <xacro:property name="front_wheel_offset_x" value="0.4"/>
  <xacro:property name="rear_wheel_offset_x" value="-0.4"/>
  <xacro:property name="headlight_radius" value="0.03"/>
  <xacro:property name="headlight_length" value="0.05"/>
  <xacro:property name="headlight_offset_y" value="0.13"/>
  <xacro:property name="caster_offset_x" value="0.70"/>

  <!-- ====================== МАТЕРИАЛЫ ====================== -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="red_down"><color rgba="0.6 0.1 0 1"/></material>
  <material name="red_up"><color rgba="0.9 0 0.2 1"/></material>
  <material name="yellow"><color rgba="1 1 0 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>

  <!-- ====================== МАКРОС ДЛЯ КОЛЕСА ====================== -->
  <xacro:macro name="wheel" params="name reflect_y offset_x">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${offset_x} ${reflect_y * wheel_offset_y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- ====================== МАКРОС ДЛЯ ФАРЫ ====================== -->
  <xacro:macro name="headlight" params="name reflect_y">
    <link name="${name}_headlight">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${headlight_radius}" length="${headlight_length}"/>
        </geometry>
        <material name="yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${headlight_radius}" length="${headlight_length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
      </inertial>
    </link>
    <joint name="${name}_headlight_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_headlight"/>
      <origin xyz="${base_size_x / 2} ${reflect_y * headlight_offset_y} ${base_height }" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ====================== ОСНОВНОЙ КОРПУС ====================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${wheel_radius + base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_size_x} ${base_size_y} ${base_height}"/>
      </geometry>
      <material name="red_down"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wheel_radius + base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_size_x} ${base_size_y} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="0.8"/>
    </inertial>
  </link>

  <!-- ====================== ВЕРХНИЙ ПРЯМОУГОЛЬНИК ====================== -->
  <link name="upper_body">
    <visual>
      <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_size_x} ${upper_size_y} ${upper_height}"/>
      </geometry>
      <material name="red_up"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_size_x} ${upper_size_y} ${upper_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.3"/>
    </inertial>
  </link>

  <joint name="upper_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_body"/>
    <origin xyz="0 0 ${base_height / 2 + upper_height / 2}" rpy="0 0 0"/>
  </joint>

  <!-- ====================== КОЛЁСА ====================== -->
  <xacro:wheel name="front_left" reflect_y="1" offset_x="${front_wheel_offset_x}"/>
  <xacro:wheel name="front_right" reflect_y="-1" offset_x="${front_wheel_offset_x}"/>
  <xacro:wheel name="rear_left" reflect_y="1" offset_x="${rear_wheel_offset_x}"/>
  <xacro:wheel name="rear_right" reflect_y="-1" offset_x="${rear_wheel_offset_x}"/>

  <!-- ====================== ФАРЫ ====================== -->
  <xacro:headlight name="left" reflect_y="1"/>
  <xacro:headlight name="right" reflect_y="-1"/>

  <!-- ====================== КАСТЕРЫ ====================== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} 0 ${caster_radius}"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="caster_front" x="${caster_offset_x}"/>
  <xacro:caster name="caster_back"  x="-${caster_offset_x}"/>

  <!-- ====================== ЛИДАР ====================== -->
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_height" value="0.1"/>
  <xacro:property name="lidar_offset_z" value="0.2"/>
  
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="upper_body"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- ====================== КАМЕРА ГЛУБИНЫ ====================== -->
  <xacro:property name="depth_camera_offset_x" value="-0.15"/>
  <xacro:property name="depth_camera_offset_y" value="0.0"/>
  <xacro:property name="depth_camera_offset_z" value="0.1"/>
  
  <link name="depth_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.05 0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="upper_body"/>
    <child link="depth_camera_link"/>
    <origin xyz="${depth_camera_offset_x} ${depth_camera_offset_y} ${depth_camera_offset_z}" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find my_unique_robot_gazebo)/config/robot.gazebo.xacro" />

  <!-- ====================== IMU СЕНСОР ====================== -->
  <xacro:property name="imu_offset_x" value="0.0"/>
  <xacro:property name="imu_offset_y" value="0.0"/>
  <xacro:property name="imu_offset_z" value="0.05"/>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height + imu_offset_z}" rpy="0 0 0"/>
  </joint>

</robot>