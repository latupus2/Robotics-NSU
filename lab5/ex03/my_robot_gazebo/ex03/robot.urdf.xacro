<?xml version="1.0"?>
<robot name="my_diff_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ====================== КОНСТАНТЫ ====================== -->
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width"  value="0.08"/>
  <xacro:property name="base_radius"  value="0.45"/>
  <xacro:property name="base_height"  value="0.30"/>
  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="wheel_offset_y" value="0.55"/>
  <xacro:property name="caster_offset_x" value="0.70"/>

  <!-- ====================== МАТЕРИАЛЫ ====================== -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>

  <!-- ====================== МАКРОС ДЛЯ КОЛЕСА ====================== -->
  <xacro:macro name="wheel" params="name reflect_y">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${reflect_y * wheel_offset_y} ${wheel_radius}" rpy="0 0 0"/>  <!-- Сдвиг по z на радиус -->
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- ====================== ОСНОВНОЙ КОРПУС ====================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${wheel_radius + base_height / 2}" rpy="0 0 0"/>  <!-- Сдвиг вверх для выравнивания -->
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wheel_radius + base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="0.8"/>
    </inertial>
  </link>

  <!-- ====================== КОЛЁСА ====================== -->
  <xacro:wheel name="left"  reflect_y="1"/>
  <xacro:wheel name="right" reflect_y="-1"/>

  <!-- ====================== КАСТЕРЫ ====================== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} 0 ${caster_radius}"/>  <!-- Сдвиг по z на радиус -->
    </joint>
  </xacro:macro>

  <xacro:caster name="caster_front" x="${caster_offset_x}"/>
  <xacro:caster name="caster_back"  x="-${caster_offset_x}"/>

  <xacro:include filename="$(find my_robot_gazebo)/ex03/robot.gazebo.xacro" />

</robot>